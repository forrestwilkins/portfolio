NODE_ENV=development

# Ports for local development. Change these if something else on your
# machine already uses them.
CLIENT_PORT=3200
SERVER_PORT=3300

# Redis for local development, e.g. `docker compose up -d cache`
REDIS_HOST=localhost
REDIS_PORT=6400
REDIS_PASSWORD=pass

# When the app itself runs in Docker (`docker compose up -d`), REDIS_HOST is
# set to `cache` by docker-compose.yml, so only the port and password above
# need to match your Compose stack.

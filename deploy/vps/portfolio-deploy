#!/usr/bin/env bash
set -euo pipefail

REPO="${PORTFOLIO_REPO:-/home/deploy/portfolio}"
COMPOSE="/usr/local/bin/portfolio-compose-up"

branch="${1:-${SSH_ORIGINAL_COMMAND:-main}}"
if [[ ! "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]]; then
  echo "Refusing branch name: $branch" >&2
  exit 1
fi

cd "$REPO"
echo "==> fetching"
git fetch --prune origin
git checkout "$branch"

echo "==> updating $branch"
git pull --ff-only origin "$branch"
echo "    now at $(git rev-parse --short HEAD) $(git log -1 --pretty=%s)"

echo "==> building and restarting"
sudo "$COMPOSE"

port="$(grep -E '^SERVER_PORT=' "$REPO/.env" | cut -d= -f2 | tr -d '"'"'"' \r')"
echo "==> health check on :$port"
for attempt in $(seq 1 30); do
  if curl --fail --silent --max-time 3 "http://127.0.0.1:$port/api/health"; then
    echo
    echo "==> deployed"
    exit 0
  fi
  sleep 2
done

echo >&2
echo "Health check never passed. The container may be unhealthy; previous" >&2
echo "images are still on the box, so 'git checkout <last good>' and rerun." >&2
exit 1

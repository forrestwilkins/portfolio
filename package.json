{
  "name": "portfolio",
  "author": "Forrest Wilkins",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "^11.19.0"
  },
  "scripts": {
    "start": "tsx watch src/main.ts",
    "start:client": "vite --host",
    "build": "tsc -b && eslint src --ext ts && tsc && babel -x .ts -d dist src",
    "build:client": "tsc -b && eslint view --ext ts,tsx && vite build --emptyOutDir true",
    "build:server-artifact": "./scripts/build-backend-artifact.sh",
    "build:client-artifact": "./scripts/build-frontend-artifact.sh",
    "build:artifacts": "npm run build:server-artifact && npm run build:client-artifact",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chriscourses/perlin-noise": "^1.0.6",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.1",
    "@mui/material": "^6.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cron": "^3.1.9",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "lucide-react": "^0.575.0",
    "path": "^0.12.7",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "react-use-websocket": "^4.10.0",
    "redis": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tone": "^15.0.4",
    "url": "^0.11.4",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.25.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-add-import-extension": "^1.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "shadcn": "^3.8.5",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dynamic-import": "^1.5.0"
  }
}
